{
  "name": "diorama-soccer-quest3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build:wasm": "mkdir -p public && clang++ --target=wasm32 -O3 -fno-builtin -nostdlib -Wl,--no-entry -Wl,--export-all -Wl,--allow-undefined -o public/soccer_engine.wasm wasm/soccer_engine.cpp",
    "build": "npm run build:wasm && tsc && vite build",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}

